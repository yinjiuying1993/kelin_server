# Copy to .env locally. Do not put real secrets in git or image layers.
APP_ENV=dev
LOG_LEVEL=INFO
# Optional in test/dev. Required in prod. Never commit a real value.
# SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
# Disposable local test DB only (compose postgres-test). Never point this at prod.
# DATABASE_URL_API=postgresql+asyncpg://kelin_test:kelin_test@127.0.0.1:5433/kelin_test
# Required in prod. Signs GET /messages keyset cursors. Never commit a real value.
# CURSOR_HMAC_SECRET=
# Live Bailian is optional until the unique adapter is wired and a deploy injects
# secrets. Never commit a real key or vendor model ID. Empty/unset keeps Chat on stub.
# BAILIAN_API_KEY=
# BAILIAN_WORKSPACE_ID=
# BAILIAN_APP_ID=
# BAILIAN_CHAT_MODEL=
# BAILIAN_EXTRACT_MODEL=
# BAILIAN_ASR_MODEL=
# BAILIAN_TTS_MODEL=
# BAILIAN_TTS_VOICE=
# BAILIAN_VISION_MODEL=
# BAILIAN_SAFETY_MODEL=
# BAILIAN_SEARCH_MODEL=
# BAILIAN_SEARCH_ENABLED=false
# Daily AI cost budget in micros. 70% warning / 100% critical alerts only; no hard stop.
# AI_DAILY_BUDGET_MICROS=10000000
# AI_BUDGET_WARNING_PERCENT=70
# AI_BUDGET_CRITICAL_PERCENT=100
# Named cost defaults, not vendor list prices.
# AI_COST_INPUT_MICROS_PER_UNIT=3
# AI_COST_OUTPUT_MICROS_PER_UNIT=15
# AI_COST_AUDIO_MICROS_PER_SECOND=1000
# AI_COST_IMAGE_MICROS_PER_IMAGE=40000
